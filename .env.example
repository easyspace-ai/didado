# Wallet Configuration
# Your wallet private key (without 0x prefix)
PRIVATE_KEY=your_private_key_here

# Optional: If you use Polymarket web UI (proxy wallet)
POLYMARKET_PROXY_ADDRESS=0xYourProxyAddress

# API Credentials (Required for token claiming and user WebSocket)
# After first run, the bot will derive these automatically
# You can then copy them here for faster startup
POLYMARKET_API_KEY=your_api_key
POLYMARKET_API_SECRET=your_api_secret
POLYMARKET_PASSPHRASE=your_passphrase

# Trading Mode
# Set to "true" for live trading with real funds
# Set to "false" or leave empty for paper trading (simulation)
LIVE_TRADING=false

# Market Configuration
# Market slug pattern (for Bitcoin 15-minute markets)
MARKET_TYPE=btc-updown-15m

# RPC Configuration
POLYGON_RPC_URL=https://polygon-rpc.com
